    "# Comparaison des impacts environnementaux des grands groupes d’aliments\n",
    "\n",
    "# Liste des indicateurs environnementaux disponibles dans la base fusionnée\n",
    "indicateurs = [\n",
    "    \"score_unique_ef\",\n",
    "    \"changement_climatique\",\n",
    "    \"utilisation_du_sol\",\n",
    "    \"epuisement_ressources_eau\",\n",
    "    \"particules_fines\",\n",
    "    \"toxicite_humaine_non_cancerogenes\",\n",
    "    \"toxicite_humaine_cancerogenes\"\n",
    "]\n",
    "\n",
    "# Calcul des statistiques environnementales par groupe alimentaire\n",
    "stats_groupes = database.groupby(\"groupe_aliment\").agg(\n",
    "    nombre_produits=(\"nom_produit\", \"count\"),\n",
    "    **{\n",
    "        indicateur + \"_moyenne\": (indicateur, \"mean\")\n",
    "        for indicateur in indicateurs\n",
    "    },\n",
    "    **{\n",
    "        indicateur + \"_mediane\": (indicateur, \"median\")\n",
    "        for indicateur in indicateurs\n",
    "    }\n",
    ")\n",
    "\n",
    "# Affichage des résultats\n",
    "display(stats_groupes)"
   ]
