   "source": [
    "\n",
    "# 6. Comparaison des impacts environnementaux\n",
    "\n",
    "indicateurs_env = [\n",
    "    \"score_unique_ef\",\n",
    "    \"changement_climatique\",\n",
    "    \"toxicite_humaine_non_cancerogenes\",\n",
    "    \"toxicite_humaine_cancerogenes\"\n",
    "]\n",
    "\n",
    "comparaison_env = analyse_vegetale.groupby(\"categorie_analyse\")[\n",
    "    indicateurs_env\n",
    "].agg([\"mean\", \"median\"])\n",
    "\n",
    "display(comparaison_env.round(3))\n",
    "\n",
    "\n",
    "# 7. Comparaison des caractéristiques nutritionnelles\n",
    "\n",
    "indicateurs_nutrition = [\n",
    "    \"Protéines, N x facteur de Jones (g 100 g)\",\n",
    "    \"Glucides (g 100 g)\",\n",
    "    \"Lipides (g 100 g)\",\n",
    "    \"Fibres alimentaires (g 100 g)\",\n",
    "    \"Fer (mg 100 g)\",\n",
    "    \"Calcium (mg 100 g)\",\n",
    "    \"SAIN\",\n",
    "    \"LIM\"\n",
    "]\n",
    "\n",
    "comparaison_nutrition = analyse_vegetale.groupby(\"categorie_analyse\")[\n",
    "    indicateurs_nutrition\n",
    "].agg([\"mean\", \"median\"])\n",
    "\n",
    "display(comparaison_nutrition.round(2))\n",
    "\n",
    "\n",
    "# 8. Comparaison des impacts climatiques\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "analyse_vegetale.boxplot(\n",
    "    column=\"changement_climatique\",\n",
    "    by=\"categorie_analyse\",\n",
    "    figsize=(8, 5)\n",
    ")\n",
    "\n",
    "plt.title(\"Comparaison des impacts climatiques\")\n",
    "plt.suptitle(\"\")\n",
    "plt.xlabel(\"Catégorie alimentaire\")\n",
    "plt.ylabel(\"Changement climatique (kg CO2 eq/kg)\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# 9. Comparaison des teneurs en protéines\n",
    "\n",
    "analyse_vegetale.boxplot(\n",
    "    column=\"Protéines, N x facteur de Jones (g 100 g)\",\n",
    "    by=\"categorie_analyse\",\n",
    "    figsize=(8, 5)\n",
    ")\n",
    "\n",
    "plt.title(\"Comparaison des teneurs en protéines\")\n",
    "plt.suptitle(\"\")\n",
    "plt.xlabel(\"Catégorie alimentaire\")\n",
    "plt.ylabel(\"Protéines (g/100 g)\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
