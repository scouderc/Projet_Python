   "source": [
    "# Identification des principaux postes du cycle de vie responsables de l’impact climatique\n",
    "\n",
    "postes_climatiques = [\n",
    "    \"changement_climatique_agriculture\",\n",
    "    \"changement_climatique_transformation\",\n",
    "    \"changement_climatique_emballage\",\n",
    "    \"changement_climatique_transport\",\n",
    "    \"changement_climatique_distribution\",\n",
    "    \"changement_climatique_consommation\"\n",
    "]\n",
    "\n",
    "# Calcul de la moyenne et de la médiane pour chaque poste\n",
    "stats_postes = database[postes_climatiques].agg([\"mean\", \"median\"]).T\n",
    "\n",
    "# Renommage des colonnes\n",
    "stats_postes.columns = [\"moyenne\", \"mediane\"]\n",
    "\n",
    "# Classement des postes selon leur impact moyen \n",
    "stats_postes = stats_postes.sort_values(\n",
    "    \"moyenne\", ascending=False\n",
    ")\n",
    "\n",
    "# Affichage du tableau final\n",
    "display(stats_postes)"
   ]
