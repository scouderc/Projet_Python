    "# Nombre de groupes et de sous-groupes alimentaires\n",
    "print(\"Nombre de groupes alimentaires :\", database[\"groupe_aliment\"].nunique())\n",
    "print(\"Nombre de sous-groupes alimentaires :\", database[\"sous_groupe_aliment\"].nunique())\n",
    "\n",
    "# Nombre de sous-groupes et de produits par groupe alimentaire\n",
    "composition_groupes = database.groupby(\"groupe_aliment\").agg(\n",
    "    nombre_sous_groupes=(\"sous_groupe_aliment\", \"nunique\"),\n",
    "    nombre_produits=(\"nom_produit\", \"count\")\n",
    ")\n",
    "\n",
    "# Affichage du tableau\n",
    "display(composition_groupes.sort_values(\"nombre_produits\", ascending=False))"
   ]
