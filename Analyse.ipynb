   "source": [
    "# Sélection du groupe viandes, œufs et poissons\n",
    "animaux = database[\n",
    "    database[\"groupe_aliment\"] == \"viandes, œufs, poissons\"\n",
    "]\n",
    "\n",
    "# Calcul des statistiques descriptives par sous-groupe\n",
    "stats_sous_groupes = animaux.groupby(\"sous_groupe_aliment\").agg(\n",
    "    nombre_produits=(\"nom_produit\", \"count\"),\n",
    "    **{\n",
    "        indicateur + \"_moyenne\": (indicateur, \"mean\")\n",
    "        for indicateur in indicateurs\n",
    "    },\n",
    "    **{\n",
    "        indicateur + \"_mediane\": (indicateur, \"median\")\n",
    "        for indicateur in indicateurs\n",
    "    }\n",
    ")\n",
    "\n",
    "# Affichage du tableau\n",
    "display(stats_sous_groupes)"
   ]
