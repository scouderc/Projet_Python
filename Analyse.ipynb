    "    \"toxicite_humaine_non_cancerogenes\",\n",
    "    \"score_unique_ef\"\n",
    "]\n",
    "\n",
    "# Matrice de corrélation\n",
    "corr = database[variables].corr(method=\"spearman\")\n",
    "\n",
    "# Graphique\n",
    "plt.figure(figsize=(11, 9))\n",
    "sns.heatmap(corr, annot=True, cmap=\"RdBu_r\",\n",
    "            vmin=-1, vmax=1, center=0, fmt=\".2f\")\n",
    "\n",
    "plt.title(\"Matrice de corrélation des variables nutritionnelles et environnementales\")\n",
    "plt.xticks(rotation=45, ha=\"right\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
